   <script>
       $(document).ready(function () {

           var btn = $('#ContentPlaceHolder1_btnAddDownload');
               btn.addClass('disabledLink'); 

          $('#ContentPlaceHolder1_CheckBox1').change(function () {

              if ($(this).is(':checked')) {
                  btn.removeClass('disabledLink');
              } else {
                  btn.addClass('disabledLink');
              }

          });
           

       });
       function btndisabled() {
          
           $('#ContentPlaceHolder1_CheckBox1').prop('checked', false);
       }
</script>
      <script>
          document.addEventListener("DOMContentLoaded", function () {
              const imageContainer = document.querySelector('.img-zoom-container');
              const img = document.querySelector('.zoom-image');
              const lens = document.querySelector('.zoom-lens');

              function getCursorPos(e) {
                  const rect = img.getBoundingClientRect();
                  const x = e.pageX - rect.left - window.pageXOffset;
                  const y = e.pageY - rect.top - window.pageYOffset;
                  return { x: x, y: y };
              }

              function moveLens(e) {
                  const pos = getCursorPos(e);
                  let x = pos.x - (lens.offsetWidth / 2);
                  let y = pos.y - (lens.offsetHeight / 2);

                  if (x > img.width - lens.offsetWidth) { x = img.width - lens.offsetWidth; }
                  if (x < 0) { x = 0; }
                  if (y > img.height - lens.offsetHeight) { y = img.height - lens.offsetHeight; }
                  if (y < 0) { y = 0; }

                  lens.style.left = x + "px";
                  lens.style.top = y + "px";
                  lens.style.backgroundPosition = "-" + (x * 3) + "px -" + (y * 3) + "px";
              }

              function showLens() {
                  lens.style.display = "block";
                  lens.style.backgroundImage = "url('" + img.src + "')";
                  lens.style.backgroundSize = (img.width * 3) + "px " + (img.height * 3) + "px";
              }

              function hideLens() {
                  lens.style.display = "none";
              }

              imageContainer.addEventListener("mousemove", moveLens);
              imageContainer.addEventListener("mouseenter", showLens);
              imageContainer.addEventListener("mouseleave", hideLens);
          });
      </script>

