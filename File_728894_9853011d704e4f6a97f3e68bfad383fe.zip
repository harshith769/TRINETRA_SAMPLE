     /* Main Menu */
.main-menu {
    list-style: none;
    padding: 0;
    margin: 0;
}

/* Parent Menu */
.sub-menu {
    position: relative;
    display: inline-block;
}

/* Hide Submenu Initially */
.sub-menu .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    min-width: 150px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 999;
}

/* Submenu Items */
.sub-menu .dropdown li {
    padding: 10px;

    background-color:#2874f0;
}

.sub-menu .dropdown li a {
    text-decoration: none;
    color: white;
    display: block;
    padding: 0;
}

/* Hover Effect */
.sub-menu:hover .dropdown {
    display: block;
}

/* Hover Background */
.sub-menu .dropdown li:hover {
    background-color: #ffffff;
}

.sub-menu .dropdown li:hover a {
    color: black;
}

@media (min-width: 375px) and (max-width: 992px) {
    nav.navbar.bootsnav .navbar-nav > li {
        float: none !important;
    }

    #navbar-menu {
        width: 100%;
    }

    .navbar-nav > li {
        display: block;
        width: 100%;
    }

    .sub-menu .dropdown {
        position: static;
        width: 100%;
    }

    .navbar-nav {
        float: none !important;
    }

    .navbar-nav > li {
        float: none;
        display: block;
        width: 100%;
    }

    /* Fix your right float cart */
    .navbar-nav > li[style*="float:right"] {
        float: none !important;
        text-align: left;
    }

    /* Submenu fix */
    .sub-menu .dropdown {
        position: static;
        display: none;
        width: 100%;
    }

    .sub-menu.active .dropdown {
        display: block;
    }
}
    </style>
    <script>
        $(document).ready(function () {
            $('.sub-menu > a').click(function (e) {
                if ($(window).width() <= 992) {
                    e.preventDefault();
                    $(this).parent().toggleClass('active');
                }
            });
        });
</script>
    <script type="text/javascript">
      

        document.addEventListener("DOMContentLoaded", function () {
            let myBtn2 = document.getElementById("myBtn2");

            window.onscroll = function () {
                if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                    $('#myBtn2').show();
                } else {
                    $('#myBtn2').hide();
                }
            };

            function smoothScrollToTop(duration) {
                const start = document.documentElement.scrollTop || document.body.scrollTop;
                const startTime = performance.now();

                function scrollStep(timestamp) {
                    const time = timestamp - startTime;
                    const progress = Math.min(time / duration, 1); 
                    const scrollTo = start * (1 - progress);  

                    window.scrollTo(0, scrollTo);

                    if (time < duration) {
                        requestAnimationFrame(scrollStep);
                    }
                }

                requestAnimationFrame(scrollStep);
            }

            myBtn2.onclick = function () {
                smoothScrollToTop(1000);  
            };
        });
    </script>

    <script>
        $(document).on('click', '.geo-link', function (e) {
            e.preventDefault();

            var url = this.href;

            if (confirm('You are about to visit the site: ' + url + ' Do you want to continue?')) {
                window.open(url, '_blank');
            }
        });
    </script>
