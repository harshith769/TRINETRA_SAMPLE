 <script type="text/javascript">
       

         document.onkeydown = function (e) {
           

             if (e.ctrlKey && e.shiftKey && e.keyCode == 73) { // Ctrl + Shift + I
                 e.preventDefault();
                 return false;
             }

             if (e.ctrlKey && e.shiftKey && e.keyCode == 74) { // Ctrl + Shift + J
                 e.preventDefault();
                 return false;
             }
             // Disable Ctrl + U (View Source)
             if (e.ctrlKey && e.keyCode == 85) { // Ctrl + U
                 e.preventDefault();
                 // alert("Viewing source is disabled on this Site.");
                 return false;
             }

             if (e.keyCode == 76 && e.shiftKey) {
                 e.preventDefault();
                 return false;
             }
         };

         document.addEventListener('contextmenu', function (e) {
             e.preventDefault();
         });

         document.addEventListener('keydown', function (e) {

             // F12
             if (e.keyCode === 123) {
                 e.preventDefault();
             }

             // Ctrl+Shift+I / J / C
             if (e.ctrlKey && e.shiftKey &&
                 (e.keyCode === 73 || e.keyCode === 74 || e.keyCode === 67)) {
                 e.preventDefault();
             }

             // Ctrl+U
             if (e.ctrlKey && e.keyCode === 85) {
                 e.preventDefault();
             }
            
         });
       

         // Block Ctrl + Click (open new tab)
         document.addEventListener('click', function (e) {
             if (e.ctrlKey) {
                 e.preventDefault();
             }
             if (e.target.closest("a")) {

                 // Block Shift, Ctrl, or Middle click
                 if (e.shiftKey || e.ctrlKey || e.button === 1) {
                     e.preventDefault();
                     return false;
                 }
             }
         });
  </script>
    
  <script type="text/javascript">
      $(document).ready(function () {   
          var originalSize = $('div').css('font-size');

          var incr = 0;
          var decr = 0;
          // reset        
          $(".resetMe").click(function () {
              incr = 0;
              decr = 0;
              $('div').css('font-size', originalSize);
          });

          // Increase Font Size          
          $(".increase").click(function () {
              incr = incr + 1;

              if (incr < 4) {

                  var currentSize = $('div').css('font-size');
                  var currentSize = parseFloat(currentSize) * 1.1;
                  $('div').css('font-size', currentSize);
              }
              return false;
          });

          // Decrease Font Size       
          $(".decrease").click(function () {
              incr = 0;
              decr = decr + 1;

              if (decr < 4) {

                  var currentFontSize = $('div').css('font-size');
                  var currentSize = $('div').css('font-size');
                  var currentSize = parseFloat(currentSize) * 0.9;
                  $('div').css('font-size', currentSize);
              }
              return false;
          });
      });
  </script>
  
    

